# Copie ce fichier en .env (jamais commité) et adapte les valeurs.
GROUP=G1
DEVICE_ID=SX-001

# Mosquitto (sur le laptop serveur : 192.168.137.1 avec le point d'accès Windows)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
# Chemin vers ca.crt : active TLS (passer MQTT_PORT à 8883)
MQTT_CA=

# API : laisser vide tant qu'elle n'existe pas (les alertes sont juste affichées)
API_URL=
# ex : API_URL=https://192.168.137.1/api/v1/alerts
API_CA=
